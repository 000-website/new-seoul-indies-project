---
import { getCollection } from "astro:content";
import GameDetail from "../../components/games/GameDetail.astro";
import { filterByLocale, getLocalizedSlug } from "../../utils/localizedRoutes";

export async function getStaticPaths() {
  const allGames = await getCollection("games");
  const games = filterByLocale(allGames, "en");

  return games.map((game) => ({
    params: {
      slug: getLocalizedSlug(game.id),
    },
    props: { game },
  }));
}

const { game } = Astro.props;
---

<GameDetail game={game} locale="en" />
