---
import { getCollection } from "astro:content";
import MeetupDetail from "../../components/meetups/MeetupDetail.astro";
import { filterByLocale, getLocalizedSlug } from "../../utils/localizedRoutes";

export async function getStaticPaths() {
  const allMeetups = await getCollection("meetups");
  const meetups = filterByLocale(allMeetups, "en");

  return meetups.map((meetup) => ({
    params: {
      slug: getLocalizedSlug(meetup.id),
    },
    props: { meetup },
  }));
}

const { meetup } = Astro.props;
---

<MeetupDetail meetup={meetup} locale="en" />
