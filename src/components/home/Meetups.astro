---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { translations } from "../../i18n/translations";
import { getLocalizedUrl, filterByLocale } from "../../utils/localizedRoutes";
import { formatDate } from "../../utils/formatDate";

interface Props {
  locale: "en" | "ko";
}

const { locale } = Astro.props;
const t = translations[locale];

const meetups = filterByLocale(await getCollection("meetups"), locale);

const today = new Date();
today.setHours(0, 0, 0, 0);

const sortedMeetups = [...meetups].sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);

const nextMeetup = sortedMeetups.find((meetup) => meetup.data.date >= today);

const previousMeetups = sortedMeetups
  .filter((meetup) => meetup.data.date < today)
  .reverse();

function getMeetupUrl(id: string) {
  return getLocalizedUrl(id, locale, "meetups");
}

function getMapSrc(meetup: CollectionEntry<"meetups">) {
  return (
    meetup.data.mapEmbedUrl ??
    `https://maps.google.com/maps?q=${encodeURIComponent(
      meetup.data.address,
    )}&output=embed`
  );
}

function getMapLinks(meetup: CollectionEntry<"meetups">) {
  const address = encodeURIComponent(meetup.data.address);

  return {
    google: `https://www.google.com/maps/search/?api=1&query=${address}`,
    kakao: `https://map.kakao.com/link/search/${address}`,
    naver: `https://map.naver.com/p/search/${address}`,
  };
}
---

<section class="mb-16">
  <div class="mb-6">
    <h3 class="text-2xl font-bold sm:text-3xl">{t.meetupTitle}</h3>
  </div>

  {nextMeetup ? (
    <div class="group mb-10 grid overflow-hidden border border-slate-700 transition hover:border-slate-500 sm:grid-cols-5">
      <!-- Map preview -->
      <div class="order-2 flex min-w-0 flex-col items-center overflow-hidden sm:order-2 sm:col-span-2">
        <div class="pt-6 pb-2">
          <iframe
            src={getMapSrc(nextMeetup)}
            title={`Map showing ${nextMeetup.data.location}`}
            width="100%"
            height="200"
            class="block h-64 w-full shrink-0 sm:h-70"
            style="border: 0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <div class="flex w-full shrink-0 justify-end gap-4 px-5 pt-0 pb-6">
          {Object.entries(getMapLinks(nextMeetup)).map(([platform, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold underline decoration-slate-500 underline-offset-4 transition"
            >
              {platform.charAt(0).toUpperCase() + platform.slice(1)}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Meetup details -->
      <div class="order-1 flex min-w-0 flex-col justify-center p-6 sm:order-1 sm:col-span-3 sm:p-8">
        <p class="mb-2 text-sm text-slate-400">
          {formatDate(nextMeetup.data.date, locale)}
          {nextMeetup.data.startTime && ` · ${nextMeetup.data.startTime}`}
          {nextMeetup.data.endTime && ` – ${nextMeetup.data.endTime}`}
        </p>

        <h4 class="mb-4 text-2xl font-bold sm:text-3xl">
          {nextMeetup.data.title}
        </h4>

        <p class="mb-1 text-sm">{nextMeetup.data.location}</p>

        <p class="mb-6 text-sm">
          <span class="font-semibold">{t.meetupEntry}</span>{" "}
          {nextMeetup.data.fee}
        </p>

        <a
          href={getMeetupUrl(nextMeetup.id)}
          class="font-semibold underline-offset-4 hover:underline"
        >
          {t.meetupDetails} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="mb-10 border border-slate-700 p-6 sm:p-8">
      <h4 class="text-xl font-bold">{t.meetupNoUpcoming}</h4>
      <p class="mt-2 text-slate-400">{t.meetupNoUpcomingDescription}</p>
    </div>
  )}

  <!-- Previous meetups -->
  <div class="mb-4 flex items-center justify-between gap-4">
    <h4 class="text-xl font-bold">{t.meetupPrevious}</h4>

    {previousMeetups.length > 1 && (
      <span class="shrink-0 text-xs text-slate-500">{t.meetupScroll}</span>
    )}
  </div>

  {previousMeetups.length > 0 ? (
    <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
      {previousMeetups.map((meetup) => (
        <a
          href={getMeetupUrl(meetup.id)}
          class="group w-[80%] shrink-0 snap-start border border-slate-700 p-5 transition hover:border-slate-500 sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]"
        >
          <p class="mb-3 text-sm text-slate-400">
            {formatDate(meetup.data.date, locale)}
          </p>

          <h5 class="mb-3 text-lg font-bold transition group-hover:text-slate-500">
            {meetup.data.title}
          </h5>

          <p class="text-sm text-slate-400">{meetup.data.location}</p>

          <p class="mt-5 text-sm font-semibold">
            {t.meetupView} <span aria-hidden="true">→</span>
          </p>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-sm italic text-slate-500">{t.meetupNoPrevious}</p>
  )}
</section>
