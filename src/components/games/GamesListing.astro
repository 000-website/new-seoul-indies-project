---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { translations } from "../../i18n/translations";
import { getLocalizedUrl, filterByLocale } from "../../utils/localizedRoutes";
import { formatDate } from "../../utils/formatDate";

interface Props {
  locale: "en" | "ko";
}

const { locale } = Astro.props;
const t = translations[locale];

const games = filterByLocale(await getCollection("games"), locale);

const sortedGames = [...games].sort((a, b) => {
  const dateA = a.data.publishDate?.getTime() ?? 0;
  const dateB = b.data.publishDate?.getTime() ?? 0;

  return dateB - dateA;
});
---

<Layout title={t.gamesTitle}>
  <main class="mx-auto max-w-7xl px-4">
    <header class="mb-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 class="mb-1 text-4xl font-bold tracking-tight">
            {t.gamesHeading}
          </h1>
          <p class="text-gray-500">{t.gamesDescription}</p>
        </div>

        <label class="block w-full md:max-w-md">
          <span class="mb-2 block text-sm font-medium">{t.gamesSearch}</span>

          <input
            id="game-search"
            type="search"
            placeholder={t.gamesPlaceholder}
            class="w-full border border-gray-200 bg-white px-4 py-3 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </label>
      </div>
    </header>

    <div id="games-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {sortedGames.map((game, index) => (
        <article
          class="game-card group overflow-hidden border border-gray-200 bg-white transition"
          data-title={game.data.title}
          data-description={game.data.description ?? ""}
          data-developer={game.data.developer ?? ""}
          data-genre={game.data.genre ?? ""}
          data-status={game.data.status ?? ""}
          data-date={game.data.publishDate?.getTime() ?? 0}
          data-original-index={index}
        >
          <a
            href={getLocalizedUrl(game.id, locale, "games")}
            class="block h-full"
          >
            {game.data.cover && (
              <img
                src={game.data.cover}
                alt={`${game.data.title} cover`}
                loading="lazy"
                class="aspect-video w-full object-cover"
              />
            )}

            <div class="p-5">
              <h2 class="text-xl font-bold">{game.data.title}</h2>

              {game.data.developer && (
                <p class="mt-1 text-sm text-gray-500">
                  {t.gamesBy} {game.data.developer}
                </p>
              )}

              <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600">
                {game.data.description}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>

    <nav
      id="games-pagination"
      class="mt-10 flex items-center justify-center gap-2"
      aria-label="Games pagination"
    ></nav>

    <div
      id="games-empty"
      class="hidden border border-dashed border-gray-300 p-12 text-center"
    >
      <h2 class="text-xl font-semibold">{t.gamesEmptyTitle}</h2>
      <p class="mt-2 text-gray-500">{t.gamesEmptyDescription}</p>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("#game-search");

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".game-card"),
  );

  const grid = document.querySelector<HTMLElement>("#games-grid");
  const empty = document.querySelector<HTMLElement>("#games-empty");
  const pagination = document.querySelector<HTMLElement>("#games-pagination");

  const ITEMS_PER_PAGE = 9;

  let currentPage = 1;

  function readURL() {
    const params = new URLSearchParams(window.location.search);

    if (searchInput) {
      searchInput.value = params.get("search") ?? "";
    }

    currentPage = Math.max(1, Number(params.get("page")) || 1);
  }

  function updateURL() {
    const url = new URL(window.location.href);
    const query = searchInput?.value.trim() ?? "";

    if (query) {
      url.searchParams.set("search", query);
    } else {
      url.searchParams.delete("search");
    }

    if (currentPage > 1) {
      url.searchParams.set("page", String(currentPage));
    } else {
      url.searchParams.delete("page");
    }

    window.history.replaceState({}, "", url);
  }

  function createPageButton(
    label: string,
    page: number,
    active = false,
    disabled = false,
  ) {
    const button = document.createElement("button");

    button.type = "button";
    button.textContent = label;
    button.disabled = disabled;

    button.className = [
      "min-w-10 px-3 py-2 text-sm border transition",
      active
        ? "bg-black text-white border-black"
        : "bg-white text-gray-700 border-gray-200 hover:bg-gray-100",
      disabled ? "opacity-40 cursor-not-allowed" : "cursor-pointer",
    ].join(" ");

    button.setAttribute(
      "aria-label",
      label === "Previous"
        ? "Previous page"
        : label === "Next"
          ? "Next page"
          : `Page ${page}`,
    );

    if (active) {
      button.setAttribute("aria-current", "page");
    }

    button.addEventListener("click", () => {
      if (disabled) return;

      currentPage = page;
      filterGames();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    return button;
  }

  function renderPagination(totalPages: number) {
    if (!pagination) return;

    pagination.innerHTML = "";

    if (totalPages <= 1) return;

    pagination.appendChild(
      createPageButton("Previous", currentPage - 1, false, currentPage === 1),
    );

    for (let page = 1; page <= totalPages; page++) {
      pagination.appendChild(
        createPageButton(String(page), page, page === currentPage),
      );
    }

    pagination.appendChild(
      createPageButton(
        "Next",
        currentPage + 1,
        false,
        currentPage === totalPages,
      ),
    );
  }

  function filterGames(updateHistory = true) {
    const query = searchInput?.value.trim().toLowerCase() ?? "";

    const filtered = cards.filter((card) => {
      const searchableText = [
        card.dataset.title,
        card.dataset.description,
        card.dataset.developer,
        card.dataset.genre,
        card.dataset.status,
      ]
        .join(" ")
        .toLowerCase();

      return searchableText.includes(query);
    });

    const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE);

    currentPage = Math.min(Math.max(1, currentPage), Math.max(1, totalPages));

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const visibleCards = filtered.slice(start, start + ITEMS_PER_PAGE);

    cards.forEach((card) => {
      card.hidden = true;
    });

    visibleCards.forEach((card) => {
      card.hidden = false;
      grid?.appendChild(card);
    });

    if (empty) {
      empty.classList.toggle("hidden", filtered.length > 0);
    }

    renderPagination(totalPages);

    if (updateHistory) {
      updateURL();
    }
  }

  searchInput?.addEventListener("input", () => {
    currentPage = 1;
    filterGames();
  });

  window.addEventListener("popstate", () => {
    readURL();
    filterGames(false);
  });

  readURL();
  filterGames(false);
</script>
