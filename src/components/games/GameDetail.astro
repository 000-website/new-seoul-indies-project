---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MediaCarousel from "./MediaCarousel.astro";
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../i18n/translations";

interface Props {
  game: CollectionEntry<"games">;
  locale: "en" | "ko";
}

const { game, locale } = Astro.props;
const t = translations[locale];
const { Content } = await render(game);
---

<Layout title={game.data.title}>
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="py-8 text-5xl font-bold">{game.data.title}</h1>

    <MediaCarousel media={game.data.media ?? []} cover={game.data.cover} />

    <!-- MAIN GRID -->
    <div class="grid gap-10 lg:grid-cols-[1fr_300px]">
      <!-- LEFT COLUMN -->
      <div>
        <article class="prose mt-10 max-w-none">
          <Content />
        </article>
      </div>

      <!-- RIGHT SIDEBAR -->
      <aside class="space-y-6">
        <!-- Description -->
        <div class="border border-default p-4">
          <p>{game.data.description}</p>
        </div>

        <!-- Game Info -->
        <div class="border border-default p-4">
          <h3 class="mb-4 font-semibold">{t.gameInfo}</h3>

          <div class="space-y-2 text-sm text-muted">
            <p>
              <span class="font-semibold text-foreground">{t.developer}:</span>
              <br />
              {game.data.developer}
            </p>

            <p>
              <span class="font-semibold text-foreground">{t.genre}:</span>
              <br />
              {game.data.genre}
            </p>

            <p>
              <span class="font-semibold text-foreground">{t.status}:</span>
              <br />
              {game.data.status}
            </p>

            {game.data.tags?.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                <p>
                  <span class="font-semibold text-foreground">{t.tags}:</span>
                  <br />
                </p>

                {game.data.tags.map((tag) => (
                  <span class="border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- LINKS -->
        <div class="border border-default p-4">
          <h3 class="mb-4 font-semibold">{t.links}</h3>

          <div class="flex flex-col gap-2 text-sm">
            {game.data.website && (
              <a
                class="text-primary hover:underline"
                href={game.data.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.website}
              </a>
            )}

            {game.data.github && (
              <a
                class="text-primary hover:underline"
                href={game.data.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            )}

            {game.data.itch && (
              <a
                class="text-primary hover:underline"
                href={game.data.itch}
                target="_blank"
                rel="noopener noreferrer"
              >
                itch.io
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
