---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../i18n/translations";
import { getLocalizedUrl, filterByLocale } from "../../utils/localizedRoutes";

interface Props {
  locale: "en" | "ko";
}

const { locale } = Astro.props;
const t = translations[locale];

const posts = filterByLocale(await getCollection("posts"), locale);

const sortedPosts = [...posts].sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;

  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;

  return dateB - dateA;
});

function getPostUrl(id: string) {
  return getLocalizedUrl(id, locale, "blog");
}
---

<Layout title={t.blogTitle}>
  <main class="mx-auto max-w-7xl px-4">
    <header class="mb-10">
      <h1 class="mb-1 text-4xl font-bold tracking-tight">{t.blogHeading}</h1>
      <p class="text-gray-500">{t.blogDescription}</p>
    </header>

    <div id="blog-grid" class="flex flex-col gap-6">
      {sortedPosts.map((post, index) => (
        <article
          class="blog-card group overflow-hidden border border-slate-200 transition-colors hover:border-slate-400"
          data-original-index={index}
        >
          <a
            href={getPostUrl(post.id)}
            class="grid grid-cols-1 sm:grid-cols-[220px_1fr]"
          >
            {post.data.coverImage && (
              <div class="aspect-[16/10] overflow-hidden bg-slate-100 sm:aspect-auto sm:min-h-full">
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            )}

            <div class="p-5 sm:p-6">
              {post.data.publishDate && (
                <span class="text-xs font-medium uppercase tracking-wider text-slate-500">
                  {post.data.publishDate}
                </span>
              )}

              <h2 class="mb-3 mt-2 text-xl font-semibold tracking-tight text-slate-900 transition-colors group-hover:text-slate-600">
                {post.data.title}
              </h2>

              {post.data.excerpt && (
                <p class="mb-4 leading-7 text-slate-600">{post.data.excerpt}</p>
              )}

              <span class="text-sm font-medium text-slate-500">
                {t.blogReadMore}
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <nav
      id="blog-pagination"
      data-previous={t.blogPrevious}
      data-next={t.blogNext}
      aria-label={t.blogPaginationLabel}
      class="mt-10 flex flex-wrap items-center justify-center gap-2"
    ></nav>

    <div
      id="blog-empty"
      class="hidden border border-dashed border-gray-300 p-12 text-center"
    >
      <h2 class="text-xl font-semibold">{t.blogEmptyTitle}</h2>
    </div>
  </main>
</Layout>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".blog-card"),
  );

  const grid = document.querySelector<HTMLElement>("#blog-grid");
  const empty = document.querySelector<HTMLElement>("#blog-empty");
  const pagination = document.querySelector<HTMLElement>("#blog-pagination");

  const previousLabel = pagination?.dataset.previous ?? "Previous";
  const nextLabel = pagination?.dataset.next ?? "Next";

  const ITEMS_PER_PAGE = 9;

  let currentPage = 1;

  function readURL() {
    const params = new URLSearchParams(window.location.search);
    currentPage = Math.max(1, Number(params.get("page")) || 1);
  }

  function updateURL() {
    const url = new URL(window.location.href);

    if (currentPage > 1) {
      url.searchParams.set("page", String(currentPage));
    } else {
      url.searchParams.delete("page");
    }

    window.history.replaceState({}, "", url);
  }

  function createPageButton(
    label: string,
    page: number,
    active = false,
    disabled = false,
  ) {
    const button = document.createElement("button");

    button.type = "button";
    button.textContent = label;
    button.disabled = disabled;

    button.className = [
      "min-w-10 px-3 py-2 text-sm border transition",
      active
        ? "bg-black text-white border-black"
        : "bg-white text-gray-700 border-gray-200 hover:bg-gray-100",
      disabled ? "opacity-40 cursor-not-allowed" : "cursor-pointer",
    ].join(" ");

    button.setAttribute(
      "aria-label",
      label === previousLabel
        ? "Previous page"
        : label === nextLabel
          ? "Next page"
          : `Page ${page}`,
    );

    if (active) {
      button.setAttribute("aria-current", "page");
    }

    button.addEventListener("click", () => {
      if (disabled) return;

      currentPage = page;
      renderPosts();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    return button;
  }

  function renderPagination(totalPages: number) {
    if (!pagination) return;

    pagination.innerHTML = "";

    if (totalPages <= 1) return;

    pagination.appendChild(
      createPageButton(
        previousLabel,
        currentPage - 1,
        false,
        currentPage === 1,
      ),
    );

    for (let page = 1; page <= totalPages; page++) {
      pagination.appendChild(
        createPageButton(String(page), page, page === currentPage),
      );
    }

    pagination.appendChild(
      createPageButton(
        nextLabel,
        currentPage + 1,
        false,
        currentPage === totalPages,
      ),
    );
  }

  function renderPosts(updateHistory = true) {
    const totalPages = Math.ceil(cards.length / ITEMS_PER_PAGE);

    currentPage = Math.min(Math.max(1, currentPage), Math.max(1, totalPages));

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const visibleCards = cards.slice(start, start + ITEMS_PER_PAGE);

    cards.forEach((card) => {
      card.hidden = true;
    });

    visibleCards.forEach((card) => {
      card.hidden = false;
      grid?.appendChild(card);
    });

    empty?.classList.toggle("hidden", cards.length > 0);

    renderPagination(totalPages);

    if (updateHistory) {
      updateURL();
    }
  }

  window.addEventListener("popstate", () => {
    readURL();
    renderPosts(false);
  });

  readURL();
  renderPosts(false);
</script>
